{
  "name": "randomcreations",
  "version": "1.0.0",
  "description": "A Hugo-powered portfolio of 3D art, game development, and design experiments.",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --cacheDir \"$PWD/.hugo_cache\" --cleanDestinationDir --gc --minify --panicOnWarning",
    "check": "pnpm run build",
    "test": "pnpm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javoire/randomcreations.git"
  },
  "author": "https://github.com/javoire",
  "bugs": {
    "url": "https://github.com/javoire/randomcreations/issues"
  },
  "homepage": "https://github.com/javoire/randomcreations#readme",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.5"
}
